# Copy to .env and fill in. Inspect loads .env from the repo root automatically.
# .env is gitignored; this file is the template and holds no secrets.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. The model used when --model is not passed on the command line.
# Any provider Inspect supports, e.g.:
#   anthropic/claude-haiku-4-5
#   anthropic/claude-sonnet-5
INSPECT_EVAL_MODEL=anthropic/claude-haiku-4-5
